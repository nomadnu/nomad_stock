# 한국투자증권(KIS) Open API 자격증명
# 1) https://apiportal.koreainvestment.com 접속 → 로그인
# 2) [모의투자] 신청 (모바일/HTS에서 모의투자 계좌 개설)
# 3) "KIS Developers" → 앱 등록 후 앱키/시크릿 발급
# 4) 아래 값을 채우고 이 파일을 ".env" 로 복사 (.env 는 절대 커밋 금지)

# paper = 모의투자(가상 돈), real = 실거래(실제 돈)
KIS_ENV=paper

KIS_APP_KEY=여기에_앱키
KIS_APP_SECRET=여기에_앱시크릿

# 계좌번호. 앞 8자리-뒤 2자리 형식. 예: 50012345-01
# (모의투자 계좌번호는 모의투자 신청 시 발급됨)
KIS_ACCOUNT_NO=12345678-01

# ===== 체결 알림 (선택) =====
# 둘 다 비워두면 콘솔/로그에만 남고 외부 알림은 생략된다.

# 텔레그램: @BotFather로 봇 생성 → 토큰 발급, 봇과 대화 시작 후 chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 이메일(SMTP): Gmail이면 '앱 비밀번호' 생성해서 SMTP_PASS에 입력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# ===== 리스크 관리 (손절/익절) =====
# 보유 종목 손익률이 이 선을 넘으면 전략 신호와 무관하게 강제 청산.
# 0(또는 빈 값)이면 해당 기능 끔. 예: 0.05 = 5%
RISK_STOP_LOSS=0.05      # -5% 도달 시 손절
RISK_TAKE_PROFIT=0.10    # +10% 도달 시 익절

# ===== 웹 대시보드 로그인 (외부 공개 시 필수) =====
# DASHBOARD_PASSWORD가 설정되면 대시보드 접속에 로그인이 필요해진다.
# 비워두면 로그인 없음 → localhost 전용으로만 쓸 것.
DASHBOARD_PASSWORD=
# 세션 서명용 비밀키. 외부 공개 시 반드시 임의의 긴 문자열로 설정.
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET=
